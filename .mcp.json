{
  "$schema": "https://raw.githubusercontent.com/anthropics/mcp/main/schema/mcp.json",
  "mcpServers": {
    "powerplan": {
      "command": "python",
      "args": ["powerplan/powerplan_server.py"],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1"
      }
    },
    "powernote-notes": {
      "command": "node",
      "args": ["powernote-mcp/server.js"]
    }
  }
}
